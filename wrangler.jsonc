{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "taskboard",
  "main": "cloud/src/index.mjs",
  "compatibility_date": "2026-07-24",
  "workers_dev": true,
  "preview_urls": false,
  "build": {
    "command": "npm run build:web"
  },
  "assets": {
    "directory": "./dist/web",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "codex-taskboard-db",
      "database_id": "f0669bd8-fd0e-413c-8449-20a8ea6b5681",
      "migrations_dir": "cloud/migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "ATTACHMENTS",
      "bucket_name": "codex-taskboard-attachments"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "REALTIME_HUB",
        "class_name": "RealtimeHub"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1-realtime-hub",
      "new_sqlite_classes": ["RealtimeHub"]
    }
  ],
  "triggers": {
    // Daily data-retention purge at 03:00 Asia/Taipei (19:00 UTC)
    "crons": ["0 19 * * *"]
  }
}
